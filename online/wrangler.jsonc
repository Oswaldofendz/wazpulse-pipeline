{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wacapital-online",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-31",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {"binding": "AI"},
  "browser": {"binding": "BROWSER"},
  "workers_dev": true,
  "observability": { "enabled": false },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "PIPELINE_ENABLED": "false",
    "AI_ENABLED": "false",
    "MEDIA_ENABLED": "false",
    "DAILY_VISUAL_LIMIT": "3",
    "HORDE_ENABLED": "false",
    "DAILY_HORDE_LIMIT": "2",
    "DAILY_LLM_LIMIT": "6",
    "MIN_PRIORITY": "65",
    "MIN_STRENGTH": "4",
    "FAST_ENABLED": "false",
    "FAST_ALERTS_ENABLED": "false",
    "DAILY_FAST_LIMIT": "12",
    "FAST_REQUEST_LIMIT": "12000",
    "TIKTOK_UPLOAD_ENABLED": "false",
    "TIKTOK_MEDIA_VERIFIED": "false"
  }
  // Before deployment, add a real D1 binding named DB using the ID returned
  // by Cloudflare. No account/database identifier is fabricated here.
  // Secrets: TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID, TELEGRAM_APPROVER_ID,
  // TELEGRAM_WEBHOOK_SECRET, ADMIN_TOKEN. Never put them in this file.
}
